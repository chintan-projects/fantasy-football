# Copy to .env and fill in. .env is gitignored and blocked from tool reads.
# Walkthrough: docs/YAHOO_SETUP.md

# --- Yahoo (required) ---
FF_YAHOO_CLIENT_ID=
FF_YAHOO_CLIENT_SECRET=
FF_YAHOO_REDIRECT_URI=https://localhost:8080/callback
# Leave this EMPTY. Yahoo refuses both fspt-r and fspt-w with "invalid_scope" and takes
# permissions from your app's own settings at developer.yahoo.com/apps instead. Probed
# 2026-09-13; every integration guide that says otherwise is stale.
FF_YAHOO_SCOPE=
# Fill these after running `make leagues`
FF_YAHOO_LEAGUE_KEY=
FF_YAHOO_TEAM_KEY=

# --- Projections ---
# At least two sources. A single source raises a startup error on purpose:
# ensembles beat individual sources in 63% of head-to-head comparisons.
FF_PROJECTION_SOURCES=["espn","fantasypros"]
FF_FANTASYPROS_API_KEY=

# --- Safety (leave these alone until `make probe` passes) ---
FF_WRITE_ENABLED=false
FF_WRITE_EXECUTOR=dryrun          # dryrun | assisted | yahoo
FF_APPROVAL_TTL_SECONDS=21600
FF_FAAB_BUDGET=100

# --- Simulation ---
FF_MONTE_CARLO_DRAWS=20000
# Leave unset for a fresh simulation each run; set an integer to reproduce one.
# FF_RANDOM_SEED=42

FF_LOG_LEVEL=INFO
FF_DATABASE_URL=sqlite:///./ff.db
