# Copy to .env and fill in. .env is gitignored and blocked from tool reads.
# Walkthrough: docs/YAHOO_SETUP.md

# --- Yahoo (required) ---
FF_YAHOO_CLIENT_ID=
FF_YAHOO_CLIENT_SECRET=
FF_YAHOO_REDIRECT_URI=https://localhost:8080/callback
# Leave this EMPTY. Yahoo refuses both fspt-r and fspt-w with "invalid_scope" and takes
# permissions from your app's own settings at developer.yahoo.com/apps instead. Probed
# 2026-09-13; every integration guide that says otherwise is stale.
FF_YAHOO_SCOPE=
# Fill these after running `make leagues`
FF_YAHOO_LEAGUE_KEY=
FF_YAHOO_TEAM_KEY=

# --- Projections ---
# At least two sources. A single source raises a startup error on purpose:
# ensembles beat individual sources in 63% of head-to-head comparisons.
# espn and sleeper are both free and need no key. Sleeper serves Rotowire's numbers,
# ESPN serves its own, and that independence is what makes averaging them worth anything.
FF_PROJECTION_SOURCES=["espn","sleeper"]

# Optional, and NOT needed for any of the above. FantasyPros costs $8.99/mo. The only
# thing it adds is rank_std, a measure of how much the experts disagree. Leave it blank.
FF_FANTASYPROS_API_KEY=

# --- Safety (leave these alone until `make probe` passes) ---
FF_WRITE_ENABLED=false
FF_WRITE_EXECUTOR=dryrun          # dryrun | assisted | yahoo
FF_APPROVAL_TTL_SECONDS=21600
FF_FAAB_BUDGET=100

# --- Simulation ---
FF_MONTE_CARLO_DRAWS=20000
# Leave unset for a fresh simulation each run; set an integer to reproduce one.
# FF_RANDOM_SEED=42

FF_LOG_LEVEL=INFO

# --- Storage ---
# Everything Yahoo does not keep: our projections, the input snapshot behind each
# recommendation, the reasoning, what you actually set, your preferences, the opponent
# model. Yahoo stays the system of record for state -- rosters, transactions and the FAAB
# balance are read from it every time and never mirrored here.
# On Fly this is /data/ff.db on the mounted volume.
FF_DATABASE_PATH=
# The NFL season. Not derived from the clock: January belongs to the previous season.
FF_SEASON=2026

# --- MCP server (see docs/DEPLOY.md) ---
# The public HTTPS address Claude connects to. OAuth callbacks are built from it, so it
# must match the deployed URL exactly.
FF_MCP_BASE_URL=http://localhost:8000
FF_MCP_HOST=127.0.0.1
FF_MCP_PORT=8000

# GitHub OAuth app credentials. GitHub is the identity provider because Claude's connectors
# support OAuth with dynamic client registration out of the box, while a plain bearer token
# is a beta feature entered by an organization administrator. Callback URL for the app is
# <FF_MCP_BASE_URL>/auth/callback.
FF_GITHUB_CLIENT_ID=
FF_GITHUB_CLIENT_SECRET=
# The one GitHub login allowed to use this server. GitHub will authenticate anybody; this
# is what makes the server yours. Leave all three blank to run locally with auth off.
FF_ALLOWED_GITHUB_LOGIN=
